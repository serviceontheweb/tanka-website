---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = 'Roadmap — Tanka';
const description = 'The development roadmap for Tanka, an independent cryptocurrency project. Work is ongoing and no launch dates are promised.';
const phases = [
  { number: '01', name: 'Establish the foundations', state: 'In development', copy: 'Clarify the project goals, technical direction, governance, and open development practices.' },
  { number: '02', name: 'Build and review the protocol', state: 'Planned', copy: 'Develop the core protocol and invite careful community review before any public network claims.' },
  { number: '03', name: 'Prepare participation tools', state: 'Planned', copy: 'Explore wallet and mining software, with security and usability as prerequisites.' },
  { number: '04', name: 'Explore everyday use', state: 'Planned', copy: 'Consider payment and merchant tools only when the underlying network is ready.' },
];
---
<SiteLayout title={title} description={description} active="/roadmap/"><section class="container py-20 sm:py-28"><p class="eyebrow">Roadmap / An evolving plan</p><h1 class="display mt-5 text-5xl font-medium leading-tight sm:text-7xl">Progress, in the<br /><span class="text-cyan">right order.</span></h1><p class="mt-7 max-w-2xl text-lg leading-8 text-silver/65">Tanka is under development. These are areas of intended work, not guarantees, release dates, or promises of future value.</p><div class="mt-16 max-w-3xl">{phases.map((phase) => <article class="relative grid grid-cols-[52px_1fr] gap-4 border-l border-cyan/25 pb-10 pl-7 last:border-transparent"><span class="absolute -left-[5px] top-1 size-[9px] rounded-full bg-cyan shadow-[0_0_14px_#12DCE6]"></span><span class="font-display text-sm text-cyan/65">{phase.number}</span><div><div class="flex flex-wrap items-center gap-3"><h2 class="display text-xl font-medium">{phase.name}</h2><span class="rounded-full border border-white/10 px-2.5 py-1 text-[.58rem] uppercase tracking-[.12em] text-silver/55">{phase.state}</span></div><p class="mt-3 max-w-xl leading-7 text-silver/60">{phase.copy}</p></div></article>)}</div></section></SiteLayout>
