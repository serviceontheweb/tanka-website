---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = 'Community — Tanka';
const description = 'Follow Tanka development and find the open-source project on GitHub.';
---
<SiteLayout title={title} description={description} active="/community/"><section class="container py-20 sm:py-28"><p class="eyebrow">Community</p><h1 class="display mt-5 max-w-4xl text-5xl font-medium leading-tight sm:text-7xl">Built in the open.<br /><span class="text-cyan">Better together.</span></h1><p class="mt-8 max-w-2xl text-lg leading-8 text-silver/65">Tanka is an open-source project. Follow the code and ongoing work on GitHub; community channels will be listed here as they are established.</p><div class="panel mt-14 max-w-2xl rounded-2xl p-7 sm:p-9"><p class="eyebrow">Start here</p><h2 class="display mt-4 text-2xl">Explore the project repository</h2><p class="mt-3 leading-7 text-silver/65">Read the source, track progress, and use the repository's public discussion and contribution features.</p><a class="button-primary mt-7" href="https://github.com/serviceontheweb/tanka">Open GitHub ↗</a></div><p class="mt-8 text-sm text-silver/45">There are no official Tanka social channels or support services linked here yet.</p></section></SiteLayout>
