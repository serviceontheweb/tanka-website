---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = 'Privacy policy — Tanka';
const description = 'Privacy information for visitors to the Tanka website.';
---
<SiteLayout title={title} description={description}><section class="container max-w-3xl py-20 sm:py-28"><p class="eyebrow">Legal / Privacy</p><h1 class="display mt-5 text-5xl font-medium sm:text-7xl">Privacy policy</h1><p class="mt-5 text-sm text-silver/50">Last updated: 22 October 2026</p><div class="mt-12 space-y-8 leading-7 text-silver/70"><section><h2 class="display text-xl text-white">About this site</h2><p class="mt-3">This is the informational website for the Tanka open-source project. This version does not ask you to create an account, submit personal details, or connect a wallet.</p></section><section><h2 class="display text-xl text-white">Hosting and logs</h2><p class="mt-3">The site is intended to be hosted on Cloudflare Pages. The hosting provider may process technical request data, such as IP address, browser information, and requested pages, in standard server and security logs. Consult Cloudflare's privacy materials for details about its processing and retention.</p></section><section><h2 class="display text-xl text-white">External links</h2><p class="mt-3">Links to GitHub and other external sites are governed by those services' own privacy practices.</p></section><section><h2 class="display text-xl text-white">Changes and contact</h2><p class="mt-3">This notice may change as the website evolves. For privacy questions, contact the project through its public GitHub repository.</p></section></div></section></SiteLayout>
