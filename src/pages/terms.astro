---
import SiteLayout from '../layouts/SiteLayout.astro';
const title = 'Terms and risk disclosures — Tanka';
const description = 'Terms of use and risk information for the Tanka website and cryptocurrency project.';
---
<SiteLayout title={title} description={description}><section class="container max-w-3xl py-20 sm:py-28"><p class="eyebrow">Legal / Important information</p><h1 class="display mt-5 text-5xl font-medium sm:text-7xl">Terms &amp; risk<br /><span class="text-cyan">disclosures.</span></h1><p class="mt-5 text-sm text-silver/50">Last updated: 22 October 2026</p><div class="mt-12 space-y-8 leading-7 text-silver/70"><section><h2 class="display text-xl text-white">Project status</h2><p class="mt-3">Tanka is under development. Its blockchain network, mining, wallet, exchange listings, and merchant payment services are not currently operational. Descriptions of future work are plans and may change or not be completed.</p></section><section><h2 class="display text-xl text-white">No financial advice or offer</h2><p class="mt-3">This website is for general informational purposes. Nothing on it is financial, investment, legal, or tax advice, or an offer, solicitation, or recommendation to buy or sell any asset.</p></section><section><h2 class="display text-xl text-white">Digital asset risks</h2><p class="mt-3">Cryptocurrency projects involve substantial uncertainty and risk, including possible total loss, security failures, technical changes, and regulatory changes. Do not rely on unverified claims about Tanka tokens, prices, rewards, listings, or services.</p></section><section><h2 class="display text-xl text-white">Use of this site</h2><p class="mt-3">You may use this site for lawful informational purposes. The site and its content are provided as-is and may change without notice. Third-party links are provided for convenience and are not endorsements.</p></section><section><h2 class="display text-xl text-white">Questions</h2><p class="mt-3">Questions about these terms can be raised through the project's public GitHub repository.</p></section></div></section></SiteLayout>
